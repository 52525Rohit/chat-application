{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chat-application",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.jsx"]
    }
  ]
}